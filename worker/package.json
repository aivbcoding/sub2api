{
  "name": "sub2api-worker",
  "version": "0.1.0",
  "private": true,
  "description": "sub2api 的 Cloudflare Workers 移植版(MVP 骨架)。上游: Wei-Shaw/sub2api (LGPL-3.0)",
  "license": "LGPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute sub2api --file=./schema/schema.sql --remote",
    "db:init:local": "wrangler d1 execute sub2api --file=./schema/schema.sql --local",
    "db:seed:local": "wrangler d1 execute sub2api --file=./schema/seed.sql --local",
    "db:query": "node tools/d1-query.mjs",
    "db:backfill-pwd": "node tools/backfill-user-passwords.mjs",
    "db:migrate-admin": "node tools/migrate-admin-accounts.mjs",
    "db:migrate-announce": "node tools/migrate-announcements.mjs",
    "typecheck": "tsc --noEmit",
    "check:ui": "node tools/check-admin-ui.mjs",
    "check:nav": "node tools/test-nav-guard.mjs",
    "check:roles": "node tools/test-roles-guard.mjs",
    "check:models": "node tools/test-models-group-scope.mjs",
    "check:billing": "node tools/test-billing-pricing.mjs",
    "check": "npm run typecheck && npm run check:ui && npm run check:nav && npm run check:roles && npm run check:models && npm run check:billing && npm run check:refs",
    "mock": "node tools/mock-upstream.mjs 9099",
    "test:e2e": "node test/e2e.mjs",
    "test:translate": "node test/translate-e2e.mjs",
    "test:admin": "node test/admin-usage-e2e.mjs",
    "test:account": "node test/admin-account-test-e2e.mjs",
    "test:groups": "node test/admin-groups-e2e.mjs",
    "test:acctalias": "node test/admin-account-alias-e2e.mjs",
    "test:audit": "node test/admin-audit-e2e.mjs",
    "test:userpwd": "node test/admin-user-password-e2e.mjs",
    "test:console": "node test/console-e2e.mjs",
    "test:modelsmulti": "node test/models-multi-account-e2e.mjs",
    "test:announce": "node test/admin-announce-e2e.mjs",
    "test:pricingdel": "node test/admin-delete-pricing-e2e.mjs",
    "test:route": "node tools/test-model-route.mjs",
    "test:alias": "node tools/test-account-alias.mjs",
    "test:discover": "node tools/test-model-discovery.mjs",
    "test:autodiscover": "node tools/test-auto-discover.mjs",
    "test:time": "node tools/test-time-format.mjs",
    "test:entry": "node tools/test-entry-path.mjs",
    "test:nav": "node tools/test-nav-guard.mjs",
    "test:roles": "node tools/test-roles-guard.mjs",
    "test:models": "node tools/test-models-group-scope.mjs",
    "test:billing": "node tools/test-billing-pricing.mjs",
    "test:all": "node tools/test-model-route.mjs && node tools/test-account-alias.mjs && node tools/test-model-discovery.mjs && node tools/test-auto-discover.mjs && node tools/test-time-format.mjs && node tools/test-entry-path.mjs && node tools/test-nav-guard.mjs && node tools/test-roles-guard.mjs && node tools/test-models-group-scope.mjs && node tools/test-billing-pricing.mjs",
    "e2e": "node tools/run-e2e.mjs",
    "verify:announce": "node tools/verify-announce-online.mjs",
    "verify:apikey": "node tools/verify-apikey-format-online.mjs",
    "check:refs": "node tools/check-skill-refs.mjs",
    "predeploy": "npm run check"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.134.0"
  }
}
